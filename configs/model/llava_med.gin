assemble.model = @UAMFST()
UAMFST.backbone = @LlavaMedBackbone()
LlavaMedBackbone.weights = "microsoft/llava-med-v1.5-mistral-7b"
LlavaMedBackbone.vision_dim = 1024
LlavaMedBackbone.text_dim = 4096

UAMFST.num_classes = 2
UAMFST.sngp_hidden = 512
UAMFST.sngp_proj = 256
UAMFST.sngp_features = 1024
UAMFST.dirichlet_hidden = 128
UAMFST.adapter_rank = 16
UAMFST.dropout = 0.1
UAMFST.mc_passes = 10
